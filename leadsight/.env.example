# Copy to .env.local and fill in. docker compose reads .env.local too.

# Database (local dev against the compose db on host port 5433).
# Inside docker compose, DATABASE_URL is overridden to point at the db service.
DATABASE_URL=postgres://leadsight:leadsight@localhost:5433/leadsight

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google OAuth client. Authorised redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
# Optional: key with the PageSpeed Insights API enabled (falls back to GOOGLE_PLACES_API_KEY)
PAGESPEED_API_KEY=

# AI: DeepSeek V4.1 Flash through the local OpenCode CLI's background service.
# One-time setup on the host (see README):
#   opencode service set port 4096
#   opencode service set password <random secret>   # same value as below
#   opencode service restart
OPENCODE_SERVER_PASSWORD=
# Default http://127.0.0.1:4096. docker compose overrides it to http://host.docker.internal:4096.
# OPENCODE_URL=
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
# Optional: an empty host folder that OpenCode sessions run in, e.g. C:\Users\you\AppData\Local\leadsight\opencode-sandbox
# OPENCODE_DIRECTORY=

# Fallback when OpenCode is unavailable (gen.pollinations.ai)
POLLINATIONS_API_KEY=
# Optional: fallback model (default openai/gpt-5.4-mini; list at https://gen.pollinations.ai/v1/models)
# POLLINATIONS_MODEL=

# Optional: competitor discovery and domain authority
BRAVE_SEARCH_API_KEY=
OPENPAGERANK_API_KEY=

# Optional: where uploads are stored (default ./data/uploads; /data/uploads in Docker)
# UPLOAD_DIR=

# Optional: local Chrome/Chromium binary for Puppeteer (auto-detected on Windows/macOS)
# CHROME_EXECUTABLE_PATH=

# Dev only: skip auth and act as a seeded dev user (server-side only)
# DISABLE_AUTH=true
# DEV_USER_ID=00000000-0000-4000-8000-000000000000
